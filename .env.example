TE_ENV=dev
TE_PROJECT_ROOT=.
TE_DATA_RAW_DIR=data/raw
TE_DATA_PROCESSED_DIR=data/processed
TE_DATA_CACHE_DIR=data/cache
TE_DUCKDB_PATH=data/cache/metadata.duckdb
TE_DEFAULT_TIMEZONE=Asia/Kolkata
TE_DEFAULT_RESOLUTION=1min
TE_LOG_LEVEL=INFO
TE_LOG_JSON=false

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# Optional: token captured after logging in through the official Kite login flow
KITE_REQUEST_TOKEN=
# Optional: comma-separated instrument tokens for live websocket subscriptions
# KITE_STREAM_TOKENS=
# Optional: secure local persistence path for the Kite access token
# KITE_TOKEN_STORE_PATH=
